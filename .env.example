# GoldenAge local configuration. Copy this file to .env and select ONE mode below.
#
# GoldenAge itself reads .env from the repository root. Values already present in
# the shell environment take precedence. Do not add `export` prefixes: this is a
# simple KEY=VALUE file, not a shell script.

# Shared local paths and web settings (optional).
GOLDENAGE_ARTIFACT_DIR=var/artifacts
GOLDENAGE_LOCAL_TIMEZONE=Europe/Berlin
# The app generates an ephemeral secret when unset. Use a long random value for a
# persistent local login session, and keep it out of Git.
# GOLDENAGE_AUTH_SECRET=replace-with-a-long-random-local-secret
# Keep 0 for HTTP on localhost; set 1 behind local HTTPS only.
GOLDENAGE_AUTH_COOKIE_SECURE=0

# Demo mode (the default): leave both DATABASE_URL and
# GOLDENAGE_LOCAL_FIRST_MODE unset. Data lives only in memory and is recreated
# every time the server starts.
# DATABASE_URL=
# GOLDENAGE_LOCAL_FIRST_MODE=

# SQLite local-first mode. This takes precedence over DATABASE_URL when enabled.
# GOLDENAGE_LOCAL_FIRST_MODE=sqlite3
# GOLDENAGE_SQLITE_PATH=var/goldenage.sqlite3
# Legacy fallback for GOLDENAGE_LOCAL_FIRST_MODE; prefer the setting above.
# GOLDENAGE_LOCAL_FIRST_DB=sqlite3

# PostgreSQL mode, for the local `docker compose` service in compose.yaml.
# Leave GOLDENAGE_LOCAL_FIRST_MODE unset when using this mode.
# DATABASE_URL=postgresql://goldenage:goldenage-local-password@127.0.0.1:5432/goldenage

# Mail import defaults (all optional). `auto` chooses Apple Mail on macOS and
# classic Outlook on Windows when available; leave unset to disable auto selection.
# GOLDENAGE_MAIL_CLIENT_MODE=auto
# GOLDENAGE_MAIL_FIXTURE_PATH=var/mail-fixture.json
# GOLDENAGE_OUTLOOK_SCAN_PER_FOLDER_LIMIT=250
# GOLDENAGE_OUTLOOK_SYNC_ENABLED=0
# GOLDENAGE_OUTLOOK_ACCOUNT=Mailbox - local@example.test
# GOLDENAGE_OUTLOOK_POLL_SECONDS=30

# Legacy Apple Mail names remain supported only as fallbacks for the matching
# options above. Prefer GOLDENAGE_MAIL_CLIENT_MODE and GOLDENAGE_MAIL_FIXTURE_PATH.
# GOLDENAGE_APPLE_MAIL_CLIENT_MODE=fixture
# GOLDENAGE_APPLE_MAIL_FIXTURE_PATH=var/mail-fixture.json

# Set to 1 only to prevent GoldenAge from loading the repository-root .env file.
# GOLDENAGE_DISABLE_DOTENV=0
